<Project Sdk="Microsoft.NET.Sdk">

  <!-- Based on BUTR Bannerlord.Module.Template (MIT, blmodfx 1.3.1.110), see ADR-0009. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BannerCoopTW</AssemblyName>
    <RootNamespace>BannerCoopTW</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <BuildForWindows>true</BuildForWindows>
    <BuildForWindowsStore>false</BuildForWindowsStore>
    <ModuleId>BannerCoopTW</ModuleId>
    <ModuleName>BannerCoopTW</ModuleName>
    <ModuleUrl>https://github.com/Torivald/BannelordCOOP</ModuleUrl>
    <HarmonyVersion>2.4.2</HarmonyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BannerCoopTW.Core\BannerCoopTW.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.129" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Harmony is provided at runtime by the Bannerlord.Harmony module (Workshop); compile-only here. -->
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Always compile against BUTR reference assemblies of the exact client build: same on CI and locally. -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion).$(GameBuild)" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="$(GameVersion).$(GameBuild)" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.SandBox" Version="$(GameVersion).$(GameBuild)" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.StoryMode" Version="$(GameVersion).$(GameBuild)" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.CustomBattle" Version="$(GameVersion).$(GameBuild)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
